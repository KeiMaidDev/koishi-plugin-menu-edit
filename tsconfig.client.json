{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@koishijs/client": ["./client/env.d.ts"]
    }
  },
  "include": ["client", "src/types.ts", "src/guards.ts", "src/command-panel.ts", "src/validation.ts", "src/console-permission.ts"]
}
